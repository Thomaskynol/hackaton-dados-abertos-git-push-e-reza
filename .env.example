# ============================================================================
# AgroPilot — raiz (.env usado pelo docker-compose.yml)
# Copie para .env e preencha. O .env real está no .gitignore — nunca commite.
# Rodando SEM Docker (local), o backend lê back/.env (veja back/.env.example).
# Todas as variáveis são opcionais e têm default seguro: sem nada preenchido,
# o sistema sobe e funciona com fallback honesto (sem IA, só dados + regras).
# ============================================================================

# ---- IA (LLM) via OpenRouter ----
# Habilita o assistente, a análise comercial, a Decisão do dia e a previsão de
# preço por IA. Sem a chave, tudo funciona com fallback (regressão/heurística).
# Gere em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo(s) em ordem de preferência (vírgula = fallback). Vazio = defaults FREE
# do código. Ex.: OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free
OPENROUTER_MODEL=
# Timeout (s) da IA nos endpoints de dados (preço/decisão) — curto p/ não travar a UI.
IA_TIMEOUT_DADOS=12

# ---- Série de preços viva (IBGE) ----
# O backend busca os anos mais recentes do IBGE sozinho. 0 desliga (sem rede).
IBGE_AUTO_UPDATE=1
IBGE_TTL_DIAS=7

# ---- Previsão de preço ----
# PRECO_PREVISAO_IA=0 força regressão (sem IA). TTL do cache e anos à frente.
PRECO_PREVISAO_IA=1
PRECO_PREVISAO_TTL_DIAS=30
PRECO_ANO_ALVO_OFFSET=2

# ---- Clima real (Open-Meteo) ----
# Alertas climáticos (geada, calor, chuva, veranico) e Decisão do dia. 0 desliga.
CLIMA_AUTO=1

# ---- Seed do banco (docker-compose, serviço "seed") ----
# URL do dump do Mongo. Deixe comentado para usar o default do compose.
# O repositório é PRIVADO: sem autenticação o download responde 404.
# O instalador tenta nesta ordem: arquivo local em seed/ -> GitHub CLI logado
# -> token em GH_TOKEN -> URL aberta em SEED_URL.
# SEED_URL=https://github.com/Thomaskynol/hackaton-dados-abertos-sql-injection/releases/download/data/agropilot.gz
# GH_TOKEN=
