# ---- AgroPilot (raiz) ----
# Usado pelo docker-compose.yml. Copie para .env e preencha.
# O arquivo .env real está no .gitignore e não deve ser commitado.

# Chave da IA (OpenRouter). Habilita a análise comercial e a PREVISÃO de preço
# por IA (que usa a série histórica real do IBGE como entrada). Sem a chave, o
# sistema usa o fallback honesto (regressão/heurística) e não quebra.
# Gere em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# URL do dump de dados (seed do Mongo), usada pelo serviço "seed" do compose.
# SEED_URL=https://github.com/Thomaskynol/hackaton-dados-abertos-sql-injection/releases/download/dados-v1/agropilot.gz

# Série de preços viva: o backend busca os anos mais recentes do IBGE sozinho.
# IBGE_AUTO_UPDATE=0 desliga (ambiente sem rede). IBGE_TTL_DIAS: dias entre buscas.
IBGE_AUTO_UPDATE=1
IBGE_TTL_DIAS=7
