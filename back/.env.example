# Configuração do Backend AgroPilot
# Copie para back/.env e preencha os valores

# Origens CORS permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# MongoDB (deixe em branco para usar apenas mock)
MONGO_URL=mongodb://localhost:27017

# LLM — preencha UMA das chaves abaixo:
#   GROQ_API_KEY      → https://console.groq.com  (gratuito, recomendado para testes)
#   OPENROUTER_API_KEY → https://openrouter.ai     (acesso a centenas de modelos)
GROQ_API_KEY=
OPENROUTER_API_KEY=
