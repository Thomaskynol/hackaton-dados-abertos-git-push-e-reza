# ---- AgroPilot backend (.env) ----
# Copie para back/.env e preencha. Nada aqui deve ser commitado com valor real.

# Origens liberadas no CORS (front local por padrão).
CORS_ORIGINS=http://localhost:3000

# MongoDB. Sem Mongo, o backend cai no fallback de arquivo/mock e segue de pé.
MONGO_URL=mongodb://localhost:27017

# ---- IA (LLM) via OpenRouter ----
# Usada pela análise comercial, pelo agente de chat e pela PREVISÃO de preço
# (a IA recebe a série histórica real do IBGE e estima o próximo ano).
# Sem esta chave, o sistema funciona com fallback honesto:
#   - análise comercial -> texto montado dos dados (origem "heuristica")
#   - previsão de preço  -> regressão sobre a série real (origem "tendencia")
# Com a chave, a previsão passa a vir do modelo (origem "ia"), sem mexer em mais nada.
# Gere a sua em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo OpenRouter (opcional; o padrão do código já é um modelo rápido).
# OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash

# ---- Série de preços VIVA (IBGE) ----
# O backend busca sozinho os anos mais recentes do IBGE (PAM) sob demanda, para
# a previsão nunca ficar velha — mesmo que o sistema rode por anos sem manutenção.
# IBGE_AUTO_UPDATE=0 desliga (útil em ambiente sem internet; usa só o cache).
IBGE_AUTO_UPDATE=1
# Dias entre revalidações de cada cultura (evita consultar a API toda hora).
IBGE_TTL_DIAS=7
