# ============================================================================
# AgroPilot — backend (.env)
# Copie este arquivo para back/.env e preencha. O back/.env é o que o backend
# carrega ao rodar local (via load_dotenv). NUNCA commite valores reais.
# Todas as variáveis têm default seguro: sem nada preenchido, o sistema sobe e
# funciona com fallback honesto (sem IA, usando dados reais e regras).
# ============================================================================

# ---- Infra ----
# Origens liberadas no CORS (o front local roda em :3000).
CORS_ORIGINS=http://localhost:3000

# MongoDB. Sem Mongo, o backend cai no fallback de arquivo/mock e segue de pé.
MONGO_URL=mongodb://localhost:27017

# ============================================================================
# IA (LLM) via OpenRouter
# ============================================================================
# Chave usada por: chat (assistente), análise comercial, Decisão do dia e
# previsão de preço. SEM a chave, tudo continua funcionando com fallback:
#   - chat            -> respostas determinísticas montadas dos dados reais
#   - análise/decisão -> texto de regras (origem "heuristica"/"regras")
#   - previsão preço  -> regressão sobre a série do IBGE (origem "tendencia")
# COM a chave, essas saídas passam a vir do modelo (origem "ia").
# Gere a sua em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo(s) do OpenRouter, em ordem de preferência (lista separada por vírgula).
# O 1º é o preferido; os demais são FALLBACK automático em rate-limit (429) /
# indisponibilidade. Os defaults do código são modelos GRÁTIS (sufixo :free,
# custo zero), escolhidos por qualidade de PT-BR + raciocínio para o RAG.
# Deixe em branco para usar os defaults. Para trocar, ex.:
#   OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free
# Dica de limites do tier grátis do OpenRouter: ~20 req/min e 50 req/dia
# (sobe para 1000/dia após comprar US$10 em créditos — compra única, não recorrente).
OPENROUTER_MODEL=

# Timeout (segundos) da IA nos endpoints de DADOS (preço e Decisão do dia).
# Nesses, a IA é enriquecimento: se o modelo grátis estiver lento, a página NÃO
# espera — cai no fallback de regras na hora. O chat usa um timeout maior.
IA_TIMEOUT_DADOS=12

# ============================================================================
# Série de preços VIVA (IBGE / PAM)
# ============================================================================
# O backend busca sozinho os anos mais recentes do IBGE sob demanda, para a
# previsão nunca ficar velha — mesmo que o sistema rode por anos sem manutenção.
# IBGE_AUTO_UPDATE=0 desliga (ambiente sem internet; usa só o cache/arquivo).
IBGE_AUTO_UPDATE=1
# Dias entre revalidações de cada cultura (evita consultar a API toda hora).
IBGE_TTL_DIAS=7

# ============================================================================
# Previsão de preço (card "Para onde o preço vem indo")
# ============================================================================
# PRECO_PREVISAO_IA=0 força a previsão por REGRESSÃO (determinística) mesmo com
# chave de IA configurada. Com 1 (default) e chave presente, usa a IA.
PRECO_PREVISAO_IA=1
# Cache da previsão por IA (dias). Mantém o número estável entre visitas e
# economiza requisições — a mesma cultura/UF/série devolve o mesmo valor.
PRECO_PREVISAO_TTL_DIAS=30
# Quantos anos à frente projetar, a partir do último dado real do IBGE.
PRECO_ANO_ALVO_OFFSET=2

# ============================================================================
# Clima real (Open-Meteo) — alertas climáticos e Decisão do dia
# ============================================================================
# Liga os alertas de geada, onda de calor, chuva forte e veranico, e alimenta a
# Decisão do dia. Usa Open-Meteo (grátis, sem chave) + IBGE para localizar o
# município. CLIMA_AUTO=0 desliga (ambiente sem internet) e o sistema segue sem clima.
CLIMA_AUTO=1
